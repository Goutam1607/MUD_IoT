[Unit]
Description=MUD file server (RFC 8520, RSA-signed MUD files on port 5000)
After=network.target

[Service]
User=pi
WorkingDirectory=/home/pi/mud_iot_project/mud_file_server
ExecStart=/home/pi/mud_iot_project/venv/bin/python3 -u server.py
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
